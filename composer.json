{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "newdebugbar/newdebugbar",
    "description": "A modern Laravel debug bar built with Livewire.",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Benjamin Crozat",
            "email": "hello@benjamincrozat.com",
            "role": "Developer",
            "homepage": "https://benjamincrozat.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "laravel/mcp": ">=0.4 <1.0",
        "livewire/livewire": "^4.3.4"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.0",
        "larastan/larastan": "^3.11",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^2.36.0 || ^3.8 || ^4.4",
        "pestphp/pest-plugin-browser": "^4.3"
    },
    "autoload": {
        "psr-4": {
            "NewDebugBar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NewDebugBar\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint",
        "lint:check": "pint --test",
        "test": [
            "@analyse",
            "@test:php",
            "@test:js",
            "@test:browser"
        ],
        "test:architecture": "pest tests/Architecture",
        "test:browser": [
            "npm run build",
            "pest --testsuite=Browser --parallel --processes=4"
        ],
        "test:feature": "pest tests/Feature",
        "test:integration": "pest tests/Integration",
        "test:js": "npm test",
        "test:php": "pest --testsuite=Package --parallel --processes=4",
        "test:production": "pest tests/Production",
        "test:unit": "pest tests/Unit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NewDebugBar\\NewDebugBarServiceProvider"
            ]
        }
    },
    "archive": {
        "exclude": [
            "/.gitattributes",
            "/.agents",
            "/.github",
            "/.gitignore",
            "/.phpunit.cache",
            "/.phpstan.cache",
            "/AGENTS.md",
            "/composer.lock",
            "/node_modules",
            "/package-lock.json",
            "/package.json",
            "/pint.json",
            "/plugins",
            "/phpunit.xml.dist",
            "/phpstan.neon.dist",
            "/phpstan",
            "/resources/css",
            "/resources/js",
            "/tests",
            "/vite.config.js",
            "/vendor"
        ]
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
